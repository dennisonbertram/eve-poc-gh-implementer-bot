# Copy to .env.local and fill in. NEVER commit real values — .env.local is gitignored.

# --- Model credential (required) ---
# The agent calls Anthropic directly via the @ai-sdk/anthropic provider.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub access for the bot's tools (required) ---
# The bot reads the issue, then clones/commits/pushes and opens a PR with this token.
# Needs "Contents: read & write" + "Pull requests: read & write" + "Issues: read"
# on the target repo. Create at https://github.com/settings/tokens
# In GitHub Actions, prefer a fine-grained PAT (the default GITHUB_TOKEN cannot push
# branches that trigger other workflows). See .github/workflows/eve-implement.yml.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Route auth for the bot's HTTP session API (required when deployed) ---
# The bot's session routes are protected by HTTP Basic (username "operator").
ROUTE_AUTH_BASIC_PASSWORD=choose-a-long-random-string

# --- Human-in-the-loop (optional, default OFF) ---
# Opening a PR is reversible, so by default the bot opens it autonomously.
# Set HUMAN_REVIEW=true to make the bot PAUSE for approval before opening a PR
# (it streams an input.requested event; approve via the session /continue endpoint).
# Merging is always left to a human on GitHub regardless of this setting.
HUMAN_REVIEW=false

# --- Production webhook channel (OPTIONAL: only for the GitHub App form) ---
# Needed only if you wire agent/channels/github.ts to a GitHub App (label-an-issue → implement).
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=another-long-random-string
